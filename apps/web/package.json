{
  "name": "pramana-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:copy": "node scripts/check-no-em-dash.mjs",
    "check:e2e-safety": "node --test scripts/e2e-database-safety.test.mjs",
    "check:demo-recorder": "node --test tests-demo/recorder-smoke.mjs",
    "check:worklet": "node scripts/check-pcm-worklet.mjs",
    "gen:api": "openapi-typescript ../../services/core/openapi.json -o src/lib/api/schema.gen.ts --default-non-nullable false",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test -c playwright.real.config.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "geist": "^1.9.0",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
