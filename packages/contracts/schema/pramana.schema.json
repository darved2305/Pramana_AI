{
  "$defs": {
    "AnswerResult": {
      "additionalProperties": false,
      "properties": {
        "extraction": {
          "$ref": "#/$defs/Extraction"
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "state": {
          "$ref": "#/$defs/InvestigationState"
        }
      },
      "required": [
        "observation",
        "extraction",
        "state"
      ],
      "title": "AnswerResult",
      "type": "object"
    },
    "BeliefSnapshot": {
      "additionalProperties": false,
      "properties": {
        "decision_entropy_bits": {
          "minimum": 0,
          "title": "Decision Entropy Bits",
          "type": "number"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/DecisionBelief"
          },
          "title": "Decisions",
          "type": "array"
        },
        "expected_loss_now_min": {
          "minimum": 0,
          "title": "Expected Loss Now Min",
          "type": "number"
        },
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/HypothesisBelief"
          },
          "title": "Hypotheses",
          "type": "array"
        },
        "hypothesis_entropy_bits": {
          "minimum": 0,
          "title": "Hypothesis Entropy Bits",
          "type": "number"
        },
        "map_decision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Map Decision"
        },
        "map_decision_probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Map Decision Probability",
          "type": "number"
        },
        "observations_used": {
          "minimum": 0,
          "title": "Observations Used",
          "type": "integer"
        },
        "open_world_probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Open World Probability",
          "type": "number"
        }
      },
      "required": [
        "hypotheses",
        "decisions",
        "hypothesis_entropy_bits",
        "decision_entropy_bits",
        "open_world_probability",
        "map_decision",
        "map_decision_probability",
        "expected_loss_now_min",
        "observations_used"
      ],
      "title": "BeliefSnapshot",
      "type": "object"
    },
    "CandidateScore": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ProbeAction"
        },
        "cost_s": {
          "exclusiveMinimum": 0,
          "title": "Cost S",
          "type": "number"
        },
        "eig_decision_bits": {
          "minimum": 0,
          "title": "Eig Decision Bits",
          "type": "number"
        },
        "eig_hypothesis_bits": {
          "minimum": 0,
          "title": "Eig Hypothesis Bits",
          "type": "number"
        },
        "net_value_min": {
          "title": "Net Value Min",
          "type": "number"
        },
        "outcomes": {
          "items": {
            "$ref": "#/$defs/OutcomePreview"
          },
          "title": "Outcomes",
          "type": "array"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "action",
        "eig_decision_bits",
        "eig_hypothesis_bits",
        "cost_s",
        "score",
        "net_value_min",
        "outcomes"
      ],
      "title": "CandidateScore",
      "type": "object"
    },
    "CreateInvestigation": {
      "additionalProperties": false,
      "properties": {
        "pack_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
          "title": "Pack Id",
          "type": "string"
        },
        "participants": {
          "items": {
            "$ref": "#/$defs/ParticipantSpec"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Participants",
          "type": "array"
        },
        "report": {
          "$ref": "#/$defs/Report"
        },
        "scenario": {
          "$ref": "#/$defs/ScenarioRequest"
        }
      },
      "required": [
        "pack_id",
        "participants",
        "report",
        "scenario"
      ],
      "title": "CreateInvestigation",
      "type": "object"
    },
    "DecisionBelief": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Probability",
          "type": "number"
        }
      },
      "required": [
        "id",
        "label",
        "probability"
      ],
      "title": "DecisionBelief",
      "type": "object"
    },
    "Directness": {
      "enum": [
        "direct",
        "hearsay",
        "assumption"
      ],
      "title": "Directness",
      "type": "string"
    },
    "EventEnvelope": {
      "additionalProperties": false,
      "properties": {
        "investigation_id": {
          "title": "Investigation Id",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "investigation_id",
        "type",
        "payload",
        "ts"
      ],
      "title": "EventEnvelope",
      "type": "object"
    },
    "Extraction": {
      "additionalProperties": false,
      "description": "Structured meaning of one participant answer. Never contains decisions.",
      "properties": {
        "directness": {
          "$ref": "#/$defs/Directness"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "hedge": {
          "$ref": "#/$defs/Hedge"
        },
        "injection_suspected": {
          "default": false,
          "title": "Injection Suspected",
          "type": "boolean"
        },
        "method": {
          "enum": [
            "rules",
            "llm",
            "structured"
          ],
          "title": "Method",
          "type": "string"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "wants_to_stop": {
          "default": false,
          "title": "Wants To Stop",
          "type": "boolean"
        }
      },
      "required": [
        "outcome",
        "hedge",
        "directness",
        "method"
      ],
      "title": "Extraction",
      "type": "object"
    },
    "Fault": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
          "title": "Component Id",
          "type": "string"
        },
        "mode": {
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "mode"
      ],
      "title": "Fault",
      "type": "object"
    },
    "FaultSpec": {
      "additionalProperties": false,
      "properties": {
        "faults": {
          "items": {
            "$ref": "#/$defs/Fault"
          },
          "maxItems": 3,
          "title": "Faults",
          "type": "array"
        }
      },
      "required": [
        "faults"
      ],
      "title": "FaultSpec",
      "type": "object"
    },
    "GroundTruthComparison": {
      "additionalProperties": false,
      "properties": {
        "abstained": {
          "title": "Abstained",
          "type": "boolean"
        },
        "concluded_decision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Concluded Decision"
        },
        "correct": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Correct"
        },
        "reveal": {
          "$ref": "#/$defs/RevealResult"
        },
        "true_decision_classes": {
          "items": {
            "type": "string"
          },
          "title": "True Decision Classes",
          "type": "array"
        }
      },
      "required": [
        "reveal",
        "true_decision_classes",
        "concluded_decision",
        "abstained",
        "correct"
      ],
      "title": "GroundTruthComparison",
      "type": "object"
    },
    "Hedge": {
      "enum": [
        "certain",
        "probable",
        "unsure"
      ],
      "title": "Hedge",
      "type": "string"
    },
    "HypothesisBelief": {
      "additionalProperties": false,
      "properties": {
        "decision_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decision Class"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Probability",
          "type": "number"
        }
      },
      "required": [
        "id",
        "label",
        "probability",
        "decision_class"
      ],
      "title": "HypothesisBelief",
      "type": "object"
    },
    "InfeasibleAction": {
      "additionalProperties": false,
      "properties": {
        "location_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
