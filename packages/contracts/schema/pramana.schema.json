      "required": [
        "id",
        "pack_id",
        "status",
        "created_at",
        "report",
        "participants",
        "sealed_commitment",
        "belief",
        "plan",
        "pending_question",
        "observations",
        "questions_asked"
      ],
      "title": "InvestigationState",
      "type": "object"
    },
    "InvestigationStatus": {
      "enum": [
        "investigating",
        "decided",
        "abstained",
        "closed"
      ],
      "title": "InvestigationStatus",
      "type": "string"
    },
    "LanguageProfile": {
      "additionalProperties": false,
      "description": "How we speak to and listen to one participant.\n\n``stt_candidates`` maps to the Prisma v3.0 ``language_code`` list (1-4 codes); one code\nforces the language, several act as a hint (docs.gnani.ai/api/STT/models/prisma-v3).",
      "properties": {
        "codemix": {
          "default": false,
          "title": "Codemix",
          "type": "boolean"
        },
        "stt_candidates": {
          "items": {
            "enum": [
              "en-IN",
              "hi-IN",
              "mr-IN",
              "bn-IN",
              "gu-IN",
              "kn-IN",
              "ml-IN",
              "pa-IN",
              "ta-IN",
              "te-IN"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Stt Candidates",
          "type": "array"
        },
        "template_language": {
          "default": "en",
          "enum": [
            "en",
            "hi",
            "mr",
            "hi-en"
          ],
          "title": "Template Language",
          "type": "string"
        }
      },
      "required": [
        "stt_candidates"
      ],
      "title": "LanguageProfile",
      "type": "object"
    },
    "MediaClientMessage": {
      "additionalProperties": false,
      "description": "JSON control frames from the browser on ``/v1/voice/stream``.",
      "properties": {
        "codemix": {
          "default": false,
          "title": "Codemix",
          "type": "boolean"
        },
        "keyterms": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keyterms"
        },
        "language_code": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "en-IN",
                  "hi-IN",
                  "mr-IN",
                  "bn-IN",
                  "gu-IN",
                  "kn-IN",
                  "ml-IN",
                  "pa-IN",
                  "ta-IN",
                  "te-IN"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language Code"
        },
        "type": {
          "enum": [
            "start",
            "stop",
            "commit"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "MediaClientMessage",
      "type": "object"
    },
    "MediaServerMessage": {
      "additionalProperties": false,
      "description": "JSON frames sent to the browser on ``/v1/voice/stream``.",
      "properties": {
        "detected_language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detected Language"
        },
        "end_of_speech_to_transcript_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Of Speech To Transcript Ms"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "model_confirmed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Confirmed"
        },
        "provider_latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Latency Ms"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "type": {
          "enum": [
            "ready",
            "speech_start",
            "processing",
            "transcript",
            "error",
            "closed"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "MediaServerMessage",
      "type": "object"
    },
    "Modality": {
      "enum": [
        "text",
        "voice",
        "tap",
        "simulated"
