        },
        "participant_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
          "title": "Participant Id",
          "type": "string"
        },
        "probe_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
