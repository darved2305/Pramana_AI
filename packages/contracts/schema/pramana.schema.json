    "ParticipantSpec": {
      "additionalProperties": false,
      "description": "A participant registered on an investigation.\n\nDisplay names are synthetic (programme rule: synthetic data only).",
      "properties": {
        "available": {
          "default": true,
          "title": "Available",
          "type": "boolean"
        },
        "display_name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "languages": {
