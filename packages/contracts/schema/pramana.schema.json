    "InvestigationState": {
      "additionalProperties": false,
      "properties": {
        "belief": {
          "$ref": "#/$defs/BeliefSnapshot"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "ground_truth": {
          "anyOf": [
            {
              "$ref": "#/$defs/GroundTruthComparison"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "title": "Observations",
          "type": "array"
        },
        "pack_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
          "title": "Pack Id",
          "type": "string"
        },
        "participants": {
          "items": {
            "$ref": "#/$defs/ParticipantSpec"
          },
          "title": "Participants",
          "type": "array"
        },
        "pending_question": {
          "anyOf": [
            {
              "$ref": "#/$defs/Question"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan": {
          "$ref": "#/$defs/PlanDecision"
        },
        "questions_asked": {
          "title": "Questions Asked",
          "type": "integer"
        },
        "report": {
          "$ref": "#/$defs/Report"
        },
        "sealed_commitment": {
          "title": "Sealed Commitment",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/InvestigationStatus"
        }
