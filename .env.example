# Copy to .env (never commit .env). Generate keys with: python scripts/dev_env.py
PRAMANA_MODE=dev
LOG_JSON=false

# PostgreSQL (python scripts/dev_db.py start)
DATABASE_URL=
PRAMANA_DB_NAMES=

# Simulator: the core holds the OPERATOR key and the participant-token PRIVATE key.
SIM_URL=http://127.0.0.1:8100
SIM_OPERATOR_KEY=
PARTICIPANT_SIGNING_KEY=
# Wraps per-person data keys (base64url, 32 bytes). Required when PRAMANA_MODE=production.
PRAMANA_PII_KEY=

# Simulator process settings: the PUBLIC half of the signing key. SIM_ORACLE_KEY is for the
# evaluation harness only and must never be given to the core.
SIM_PARTICIPANT_PUBLIC_KEY=
SIM_ORACLE_KEY=
SIM_CORS_ORIGINS=["http://localhost:3000"]

# Console sign-in (docs/adr/0010-authentication.md). Sign-in is enforced unless PRAMANA_MODE=test.
# Create users with: uv run python -m pramana_core.auth.bootstrap --email ... --roles operator,approver
# Scripts and bots act as operator + approver with this key (header X-Automation-Key).
CORE_AUTOMATION_KEY=
SESSION_TTL_S=43200
SESSION_IDLE_TTL_S=3600

# Optional: email invitation links through a Gmail account (free). Create an App Password at
# https://myaccount.google.com/apppasswords and never commit it. Without all three values, the
# owner shares the link themselves. PUBLIC_WEB_URL is the address people open the console at.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
PUBLIC_WEB_URL=

# Google sign-in (ADR 0016). Values stay server-side. Register the exact redirect URI.
# PRAMANA_MODE=production refuses a non-Google issuer, CORE_AUTOMATION_KEY, insecure
# cookies, disabled authentication and a database role that bypasses row-level security.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OIDC_ISSUER=https://accounts.google.com
OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
OIDC_REDIRECT_URL=http://localhost:3102/api/core/v1/auth/google/callback
# Local fake: python scripts/mock_oidc.py --port 8410. Set issuer/discovery to localhost:8410,
# client ID to pramana-local and secret to local-only. Only dev/test may use HTTP issuers.

# Gnani (server-side only; never exposed to the browser)
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
# Account limits: STT REST 60/min, STT WebSocket 20 concurrent, TTS 60/min. Stay below them.
GNANI_STT_REST_PER_MIN=50
GNANI_TTS_PER_MIN=50
GNANI_MAX_STREAMS=16
GNANI_REST_MAX_INFLIGHT=1
# Daily spend cap in rupees (1 credit = Rs 1), checked before every Gnani call.
VOICE_DAILY_BUDGET_INR=150
VOICE_MAX_STREAM_S=300

CORS_ORIGINS=["http://localhost:3000"]

# Free-tier LLMs for the benchmark's LLM baseline (never needed at runtime)
GEMINI_API_KEY=
GROQ_API_KEY=

# Budget Cloud Run starter deployment. Set these only for the approved Mumbai database.
# The current Singapore Supabase ref in a development .env is not eligible for real data.
GCP_PROJECT_ID=luminous-slice-514102-f4
GCP_BILLING_ACCOUNT_ID=
PRAMANA_SUPABASE_REGION=
PRAMANA_SUPABASE_REF=
PRAMANA_SUPABASE_POOLER_HOST=
PRAMANA_SUPABASE_DATABASE=postgres
PRAMANA_SUPABASE_DB_PASSWORD=
PRAMANA_SUPABASE_APP_PASSWORD=
# Set to true only after Darshan rotates each credential for the approved Mumbai project.
PRAMANA_SUPABASE_CREDENTIALS_ROTATED=false
PRAMANA_SUPABASE_APP_PASSWORD_ROTATED=false
PRAMANA_SUPABASE_SECRET_KEY_ROTATED=false
PRAMANA_GOOGLE_OAUTH_CLIENT_SECRET_ROTATED=false
PRAMANA_GMAIL_APP_PASSWORD_ROTATED=false
# Second-opinion answer extractor (rules first): gemini | groq | none
LLM_EXTRACTOR_PROVIDER=none
