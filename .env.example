# Copy to .env (never commit .env). Generate keys with: python scripts/dev_env.py
PRAMANA_MODE=dev
LOG_JSON=false

# PostgreSQL (python scripts/dev_db.py start)
DATABASE_URL=postgresql+asyncpg://pramana@localhost:5433/pramana

# Simulator: the core holds the OPERATOR key and the participant-token PRIVATE key.
SIM_URL=http://127.0.0.1:8100
SIM_OPERATOR_KEY=
PARTICIPANT_SIGNING_KEY=

# Simulator process settings: the PUBLIC half of the signing key. SIM_ORACLE_KEY is for the
# evaluation harness only and must never be given to the core.
SIM_PARTICIPANT_PUBLIC_KEY=
SIM_ORACLE_KEY=
SIM_CORS_ORIGINS=["http://localhost:3000"]

# Gnani (server-side only; never exposed to the browser)
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_MAX_CONCURRENCY=1

CORS_ORIGINS=["http://localhost:3000"]
